{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "generated/**"],
      "env": ["DATABASE_URL", "WEB_ORIGIN", "SUPABASE_URL", "SUPABASE_JWKS_URL"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
