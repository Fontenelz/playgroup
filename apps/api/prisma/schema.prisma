// Schema traduzido de supabase/migrations/001_initial_schema.sql.
// Auth continua no Supabase (users.id = auth.users.id / JWT "sub") — como esse
// Postgres é um banco separado, não há FK real para auth.users aqui, só a
// convenção de reusar o mesmo UUID.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SkillLevel {
  beginner
  intermediate
  advanced
  professional
}

enum GroupAccessType {
  public
  private
  invite
}

enum GroupPlan {
  free
  starter
  pro
  business
}

enum MemberRole {
  admin
  organizer
  participant
}

enum MemberType {
  monthly
  regular
  guest
}

enum MemberStatus {
  pending
  active
  suspended
  banned
}

enum EventStatus {
  draft
  published
  open
  completed
  cancelled
}

enum ParticipantStatus {
  confirmed
  pending
  declined
  absent
  present
}

enum WaitlistStatus {
  waiting
  notified
  confirmed
  expired
  left
}

enum PaymentType {
  monthly
  per_event
  partial
  fine
}

enum PaymentStatus {
  pending
  paid
  overdue
  cancelled
  refunded
}

enum EventVisibility {
  link_only
  public
}

model User {
  id         String     @id @db.Uuid
  email      String?    @unique
  name       String
  nickname   String
  avatarUrl  String?    @map("avatar_url")
  city       String?
  bio        String?
  sports     String[]   @default([])
  skillLevel SkillLevel @default(intermediate) @map("skill_level")
  isGuest    Boolean    @default(false) @map("is_guest")
  pushToken  String?    @map("push_token")
  settings   Json       @default("{}")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  adminOfGroups       Group[]             @relation("GroupAdmin")
  memberships         GroupMember[]
  createdInviteCodes  InviteCode[]
  createdEvents       Event[]             @relation("EventCreator")
  eventParticipations EventParticipant[]
  waitlistEntries     Waitlist[]
  payments            Payment[]           @relation("PaymentUser")
  paymentsMade        Payment[]           @relation("PaymentPaidBy")
  notifications       Notification[]

  @@map("users")
}

model Group {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  slug          String          @unique
  description   String?
  sport         String
  coverUrl      String?         @map("cover_url")
  adminId       String          @map("admin_id") @db.Uuid
  accessType    GroupAccessType @default(invite) @map("access_type")
  maxMembers    Int             @default(20) @map("max_members")
  monthlyFee    Decimal?        @map("monthly_fee") @db.Decimal(10, 2)
  perEventFee   Decimal?        @map("per_event_fee") @db.Decimal(10, 2)
  paymentDay    Int?            @map("payment_day")
  pixKey        String?         @map("pix_key")
  plan          GroupPlan       @default(free)
  deletedAt     DateTime?       @map("deleted_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  admin       User          @relation("GroupAdmin", fields: [adminId], references: [id])
  members     GroupMember[]
  inviteCodes InviteCode[]
  events      Event[]
  payments    Payment[]

  @@map("groups")
}

model GroupMember {
  id           String       @id @default(uuid()) @db.Uuid
  groupId      String       @map("group_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  role         MemberRole   @default(participant)
  memberType   MemberType   @default(regular) @map("member_type")
  status       MemberStatus @default(active)
  monthlySlot  Boolean      @default(false) @map("monthly_slot")
  skillRating  Int          @default(3) @map("skill_rating")
  joinedAt     DateTime     @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

model InviteCode {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  code      String    @unique
  createdBy String    @map("created_by") @db.Uuid
  maxUses   Int?      @map("max_uses")
  uses      Int       @default(0)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User  @relation(fields: [createdBy], references: [id])

  @@index([code])
  @@map("invite_codes")
}

model Event {
  id                     String           @id @default(uuid()) @db.Uuid
  groupId                String?          @map("group_id") @db.Uuid
  visibility             EventVisibility? @map("visibility")
  title                  String
  description            String?
  sport                  String
  startsAt               DateTime         @map("starts_at")
  endsAt                 DateTime         @map("ends_at")
  locationName           String?          @map("location_name")
  locationAddress        String?          @map("location_address")
  maxParticipants        Int              @default(14) @map("max_participants")
  monthlySlots           Int              @default(0) @map("monthly_slots")
  participantCount       Int              @default(0) @map("participant_count")
  status                 EventStatus      @default(published)
  isRecurring            Boolean          @default(false) @map("is_recurring")
  recurrenceRule         String?          @map("recurrence_rule")
  monthlyConfirmDeadline DateTime?        @map("monthly_confirm_deadline")
  eventFee               Decimal?         @map("event_fee") @db.Decimal(10, 2)
  notes                  String?
  createdBy              String?          @map("created_by") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  group        Group?             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator      User?              @relation("EventCreator", fields: [createdBy], references: [id])
  participants EventParticipant[]
  waitlist     Waitlist[]
  payments     Payment[]

  @@index([groupId])
  @@index([startsAt])
  @@index([visibility, startsAt])
  @@map("events")
}

model EventParticipant {
  id            String            @id @default(uuid()) @db.Uuid
  eventId       String            @map("event_id") @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  status        ParticipantStatus @default(pending)
  isMonthly     Boolean           @default(false) @map("is_monthly")
  confirmedAt   DateTime?         @map("confirmed_at")
  goals         Int               @default(0)
  assists       Int               @default(0)
  isLateCancel  Boolean           @default(false) @map("is_late_cancel")
  paymentId     String?           @map("payment_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_participants")
}

model Waitlist {
  id         String         @id @default(uuid()) @db.Uuid
  eventId    String         @map("event_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  position   Int
  status     WaitlistStatus @default(waiting)
  isMonthly  Boolean        @default(false) @map("is_monthly")
  joinedAt   DateTime       @default(now()) @map("joined_at")
  expiresAt  DateTime?      @map("expires_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("waitlists")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  groupId        String        @map("group_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  eventId        String?       @map("event_id") @db.Uuid
  type           PaymentType
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(pending)
  dueDate        DateTime      @map("due_date") @db.Date
  paidAt         DateTime?     @map("paid_at")
  referenceMonth DateTime?     @map("reference_month") @db.Date
  pixKey         String?       @map("pix_key")
  paidBy         String?       @map("paid_by") @db.Uuid
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  group      Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User   @relation("PaymentUser", fields: [userId], references: [id])
  payer      User?  @relation("PaymentPaidBy", fields: [paidBy], references: [id])
  event      Event? @relation(fields: [eventId], references: [id])

  @@index([userId])
  @@index([groupId])
  @@map("payments")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json     @default("{}")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
