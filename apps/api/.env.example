# Prisma datasource — Postgres local via docker-compose (pnpm db:up)
DATABASE_URL="postgresql://playgroup:playgroup@localhost:5433/playgroup"
# Conexão direta (sem pooler). Em produção (Neon) precisa ser distinta de DATABASE_URL;
# localmente aponta pro mesmo Postgres.
DIRECT_URL="postgresql://playgroup:playgroup@localhost:5433/playgroup"

# Supabase (usado só para Auth — JWT/JWKS)
SUPABASE_URL="https://<seu-projeto>.supabase.co"
SUPABASE_JWKS_URL="https://<seu-projeto>.supabase.co/auth/v1/.well-known/jwks.json"

# CORS — lista separada por vírgula
WEB_ORIGIN="http://localhost:3000"

# PORT="3333"
