# Supabase (client Auth — browser e server)
NEXT_PUBLIC_SUPABASE_URL="https://<seu-projeto>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# API NestJS
# API_URL é usada em Server Actions (lib/api/client.ts).
# NEXT_PUBLIC_API_URL é usada client-side (SessionProvider.tsx).
# Mantenha as duas sincronizadas apontando pro mesmo endereço.
API_URL="http://localhost:3333"
NEXT_PUBLIC_API_URL="http://localhost:3333"

# Opcional — origin usado para montar redirect URLs de OAuth (fallback: header
# "origin" da própria request se não definida)
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
